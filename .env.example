# Copy to .env.local (pnpm dev) or .env (docker compose) and fill in. Never commit real values.
ANTHROPIC_API_KEY=
# Stripe: test-mode keys only (the app refuses live keys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: signing secret for /api/stripe/webhook (503 when unset)
STRIPE_WEBHOOK_SECRET=
# Optional: HMAC secret for the ots_pro cookie (defaults to a hash of STRIPE_SECRET_KEY)
PRO_COOKIE_SECRET=
# Optional: public base URL for Stripe redirects (defaults to the request origin)
APP_URL=

# Deploy only
# Host port for docker compose, bound to 127.0.0.1 (default 3200)
APP_PORT=
# Docker network shared with the reverse proxy
PROXY_NETWORK=
PROXY_EXTERNAL=
