# Copy to .env.local (pnpm dev) or .env (docker compose) and fill in. Never commit real values.
ANTHROPIC_API_KEY=
# Stripe: test-mode keys only (the app refuses live keys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: signing secret for /api/stripe/webhook (503 when unset)
STRIPE_WEBHOOK_SECRET=
# Optional: HMAC secret for the ots_pro cookie (defaults to a hash of STRIPE_SECRET_KEY)
PRO_COOKIE_SECRET=
# Optional: public base URL for Stripe redirects (defaults to the request origin)
APP_URL=

# Optional: ElevenLabs speech (STT + TTS). Unset = browser speech only (Web Speech API + speechSynthesis).
ELEVENLABS_API_KEY=
# Optional: TTS voice (default cjVigY5qzO86Huf0OWal "Eric"), models (eleven_flash_v2_5 / scribe_v3)
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_STT_MODEL=
# Optional: daily UTC caps (defaults 3000 TTS characters, 600 STT seconds)
ELEVENLABS_DAILY_TTS_CHARS=
ELEVENLABS_DAILY_STT_SECONDS=
# Optional: credit reserve. Until RESERVE_UNTIL keep RESERVE_CREDITS (defaults 2026-11-15T07:00:00Z, 3000);
# after it STT spends down to FLOOR_CREDITS (200), TTS to TTS_FLOOR_CREDITS (1000).
ELEVENLABS_RESERVE_UNTIL=
ELEVENLABS_RESERVE_CREDITS=
ELEVENLABS_FLOOR_CREDITS=
ELEVENLABS_TTS_FLOOR_CREDITS=
# Optional: plan credits for the local balance estimate (default 10000)
ELEVENLABS_START_CREDITS=
# Optional: TTS audio cache directory (default .cache/tts = /app/.cache/tts in Docker)
TTS_CACHE_DIR=
# Optional: bearer secret for POST /api/speech/prewarm (route is 404 when unset)
TTS_PREWARM_SECRET=
# Optional: HMAC secret for TTS tokens (defaults to one derived from PRO_COOKIE_SECRET)
TTS_TOKEN_SECRET=

# Deploy only
# Host port for docker compose, bound to 127.0.0.1 (default 3200)
APP_PORT=
# Docker network shared with the reverse proxy
PROXY_NETWORK=
PROXY_EXTERNAL=
